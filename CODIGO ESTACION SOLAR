// ════════════════════════════════════════════════════════════
//  CALLBACKS RS-485
// ════════════════════════════════════════════════════════════
void preTransmission()  { digitalWrite(MAX485_RE_DE, HIGH); }
void postTransmission() { digitalWrite(MAX485_RE_DE, LOW);  }

// ════════════════════════════════════════════════════════════
//  LECTURA SENSORES METEOROLÓGICOS
// ════════════════════════════════════════════════════════════
void readSensors() {
  uint8_t result = node.readHoldingRegisters(21, 2);
  if (result == node.ku8MBSuccess) {
    uint16_t lowWord  = node.getResponseBuffer(0);
    uint16_t highWord = node.getResponseBuffer(1);
    uint32_t raw = ((uint32_t)highWord << 16) | lowWord;
    memcpy(&gIrradiance, &raw, sizeof(gIrradiance));
    if (gIrradiance < 0) gIrradiance = 0;
  } else {
    gIrradiance = NAN;
  }

  sensors1.requestTemperatures();
  gTempDS  = sensors1.getTempCByIndex(0);
  gHumDHT  = dht.readHumidity();
  gTempDHT = dht.readTemperature();

  Serial.println("----------------------------------------");
  Serial.printf("Irradiancia: %.2f W/m²\n", isnan(gIrradiance) ? 0 : gIrradiance);
  Serial.printf("T. Panel:    %.2f °C\n",   isnan(gTempDS)     ? 0 : gTempDS);
  Serial.printf("T. Ambiente: %.2f °C\n",   isnan(gTempDHT)    ? 0 : gTempDHT);
  Serial.printf("Humedad:     %.2f %%\n",   isnan(gHumDHT)     ? 0 : gHumDHT);
}

// ════════════════════════════════════════════════════════════
//  LECTURA ENVOY LOCAL
// ════════════════════════════════════════════════════════════
void readEnvoy() {
  if (WiFi.status() != WL_CONNECTED) return;

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(8);

  HTTPClient https;
  String url = "https://" + String(ENVOY_IP) + "/production.json";
  https.begin(client, url);
  https.addHeader("Authorization", String("Bearer ") + ENVOY_TOKEN);
  https.setTimeout(8000);

  int httpCode = https.GET();
  if (httpCode == 200) {
    String payload = https.getString();
    DynamicJsonDocument doc(4096);
    if (!deserializeJson(doc, payload)) {
      JsonArray production = doc["production"];
      for (JsonObject item : production) {
        String type = item["type"].as<String>();
       if (type == "inverters") {
  gPotencia     = item["wNow"].as<float>();
  gEnergiaTotal = item["whLifetime"].as<float>() / 1000000.0;
  gActivos      = item["activeCount"].as<int>();
  gEnergiaDia   = item["wattHoursToday"].as<float>() / 1000.0;
}
        if (type == "eim") {
          gCorriente  = item["rmsCurrent"].as<float>();
          gVoltaje    = item["rmsVoltage"].as<float>();
          gEnergiaDia = item["whToday"].as<float>() / 1000.0;
        }
      }
      Serial.println("--- Envoy ---");
      Serial.printf("Potencia:  %.1f W | Corriente: %.3f A | Voltaje: %.1f V\n",
                    gPotencia, gCorriente, gVoltaje);
      Serial.printf("Energía hoy: %.3f kWh | Activos: %d\n", gEnergiaDia, gActivos);
    }
  } else {
    Serial.printf("Error Envoy HTTP: %d\n", httpCode);
  }
  https.end();
}

// ════════════════════════════════════════════════════════════
//  ENVIAR A GOOGLE SHEETS
// ════════════════════════════════════════════════════════════
void sendToGoogleSheets() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Sin WiFi — datos no enviados");
    return;
  }

  float irr  = isnan(gIrradiance) ? 0.0f : gIrradiance;
  float tDS  = isnan(gTempDS)     ? 0.0f : gTempDS;
  float tDHT = isnan(gTempDHT)    ? 0.0f : gTempDHT;
  float hDHT = isnan(gHumDHT)     ? 0.0f : gHumDHT;

  String url = String(scriptURL);
  url += "?device_id=esp32_01";
  url += "&irradiancia="          + String(irr,  2);
  url += "&temperatura_panel="    + String(tDS,  2);
  url += "&temperatura_ambiente=" + String(tDHT, 2);
  url += "&humedad="              + String(hDHT, 2);
  url += "&potencia="             + String(gPotencia,  1);
  url += "&energia="              + String(gEnergiaDia,3);
  url += "&corriente="            + String(gCorriente, 3);
  url += "&voltaje="              + String(gVoltaje,   1);

  Serial.println("URL: " + url);
  Serial.println("Enviando a Google Sheets...");

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient https;
  https.begin(client, url);
  https.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  https.setTimeout(10000);

  int httpCode = https.GET();
  Serial.printf("HTTP: %d — %s\n", httpCode, https.getString().c_str());
  https.end();
}

