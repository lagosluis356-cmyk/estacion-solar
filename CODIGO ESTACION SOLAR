// ════════════════════════════════════════════════════════════
//  SETUP
// ════════════════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("Iniciando Estacion Solar UAC...");

  // RS-485 Modbus
  RS485Serial.begin(9600, SERIAL_8N2, 17, 5);
  pinMode(MAX485_RE_DE, OUTPUT);
  digitalWrite(MAX485_RE_DE, LOW);
  node.begin(1, RS485Serial);
  node.preTransmission(preTransmission);
  node.postTransmission(postTransmission);

  // Sensores
  sensors1.begin();
  dht.begin();

  // Primera lectura
  readSensors();

  // WiFi
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("Conectado. IP: ");
  Serial.println(WiFi.localIP());

  // Primera lectura Envoy — ANTES del envío a Sheets
  Serial.println("Leyendo Envoy...");
  readEnvoy();
  delay(2000); // esperar 2s para asegurar que los datos estén listos

  // Primer envío a Sheets con datos del Envoy incluidos
  sendToGoogleSheets();

  // Servidor web
  server.on("/",     HTTP_GET, handleRoot);
  server.on("/data", HTTP_GET, handleData);
  server.begin();
  Serial.println("Servidor HTTP iniciado");
}

// ════════════════════════════════════════════════════════════
//  LOOP
// ════════════════════════════════════════════════════════════
void loop() {
  server.handleClient();

  unsigned long now = millis();

  if (now - lastSensorRead >= sensorInterval) {
    lastSensorRead = now;
    readSensors();
  }

  if (now - lastEnvoyRead >= envoyInterval) {
    lastEnvoyRead = now;
    readEnvoy();
  }

  if (now - lastSendToSheet >= sendInterval) {
    lastSendToSheet = now;
    sendToGoogleSheets();
  }
}
